# Copy to .env and keep private. THESE ARE EXAMPLES, NOT WORKING SECRETS.
SEO_PRODUCTION=1
SEO_FORM_ENABLED=1
SEO_COOKIE_SECURE=1
SEO_PUBLIC_HOST=seooutsourcingphilippines.com
SEO_FORM_SECRET=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
