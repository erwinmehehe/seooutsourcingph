SEO_FORM_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
SEO_LEADS_DATA_DIR=/secure/private/seo-outsource-leads
SEO_RETENTION_DAYS=90
NOTIFY_EMAIL=info@seooutsourcingphilippines.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Set only when your HTTPS proxy is trusted and correctly configured.
SEO_TRUSTED_PROXY_IPS=127.0.0.1
